# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable is read via arag.config.Settings; nothing here has a default in code,
# and anything credential-shaped fails loudly at first use rather than sending an empty
# header and producing a confusing 401.

ARAG_ENV=local
ARAG_LOG_LEVEL=INFO

# --- Credentials (no defaults, ever) -----------------------------------------
# Gemini free tier. NOTE (spike S1): the free tier is believed to use submitted data for
# product improvement. Until that is verified, treat outbound PII redaction as a
# functional requirement, not a demo, and do not send real personal data through it.
ARAG_GEMINI_API_KEY=

# Neon Postgres (pgvector + tsvector + LangGraph checkpointer + eval_runs).
# Format: postgresql://user:password@host/db?sslmode=require
ARAG_DATABASE_URL=

# Langfuse tracing (free cloud tier). Optional; tracing degrades to logs only if unset.
ARAG_LANGFUSE_PUBLIC_KEY=
ARAG_LANGFUSE_SECRET_KEY=

# --- Local offline models (your 24GB GPU) ------------------------------------
ARAG_OLLAMA_BASE_URL=http://localhost:11434
ARAG_JUDGE_MODEL=qwen2.5:32b-instruct-q4_K_M
ARAG_CONTEXTUALISER_MODEL=qwen2.5:7b-instruct

# --- Online models (Vercel function, CPU only) -------------------------------
# Verified working 2026-09-20 with a live call (9 in / 1 out tokens).
# gemini-2.0-flash was the DESIGN choice and is now RETIRED - the API returns HTTP 404
# with "no longer available", not a deprecation warning, so a pinned model is a hard
# outage rather than a slow drift. Re-check on any generation failure that looks like a
# 404 before assuming the key is wrong.
ARAG_GENERATOR_MODEL=gemini-3.6-flash
ARAG_GENERATOR_PRICE_KEY=gemini-flash-free
ARAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
ARAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval knobs --------------------------------------------------------
# These are tuned by the eval suite and recorded in EVAL_LOG.md. Changing one without a
# recorded run is how a project ends up with numbers nobody can reproduce.
ARAG_DENSE_TOP_K=30
ARAG_LEXICAL_TOP_K=30
ARAG_LEXICAL_PREFILTER_K=200
ARAG_RRF_K=60
ARAG_RERANK_TOP_N=6
ARAG_ABSTAIN_THRESHOLD=0.35
